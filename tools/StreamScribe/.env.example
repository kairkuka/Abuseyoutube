# Telegram: create/reuse a bot token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Optional. Leave blank and use Connect after sending /start to the bot.
TELEGRAM_CHAT_ID=

# Required only for like monitoring and YouTube live-chat monitoring.
YOUTUBE_INNERTUBE_API_KEY=

TRIGGER_WORDS=giveaway
TRIGGER_COOLDOWN_SECONDS=90
LIKE_CHECK_SECONDS=300
ENABLE_LIKE_MONITOR=false
ENABLE_FORM_LINK_MONITOR=false
WHISPER_MODEL=base.en
WHISPER_LANGUAGE=en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
SILENCE_THRESHOLD=0.0015

# Optional: run another isolated StreamScribe process from the same installation.
STREAMSCRIBE_PORT=8765
STREAMSCRIBE_INSTANCE_ID=
STREAMSCRIBE_OPEN_BROWSER=true
TELEGRAM_MESSAGE_HEADER=
